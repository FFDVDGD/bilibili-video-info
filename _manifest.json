{
  "manifest_version": 2,
  "version": "0.1.3",
  "name": "Bilibili 视频信息与 AI 总结",
  "description": "拦截群聊中的 B 站视频链接，提取元数据、字幕或语音转写，并生成简洁总结",
  "author": {
    "name": "FFDVDGD",
    "url": "https://github.com/FFDVDGD"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/FFDVDGD/bilibili-video-info"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.1.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.0,<1.0.0"
    },
    {
      "type": "python_package",
      "name": "oss2",
      "version_spec": ">=2.19.1,<3.0.0"
    }
  ],
  "capabilities": [
    "chat.open_session",
    "llm.generate",
    "maisaka.context.append",
    "send.hybrid",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "ffdvdgd.bilibili-video-info"
}
